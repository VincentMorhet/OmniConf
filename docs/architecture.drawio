connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cr1" value="&lt;b&gt;Compte rendu final : plusieurs modèles se contrôlent&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#595959'&gt;lancé automatiquement à la fin de la réunion · ~6 à 15 min&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="50" as="geometry"/></mxCell><mxCell id="cr2" value="&lt;b&gt;Transcription complète&lt;/b&gt;&lt;br/&gt;intervenants notés {S1}, {S2}, {ME}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#7F7F7F;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="300" height="60" as="geometry"/></mxCell><mxCell id="cr3" value="1 · Trois rédactions indépendantes, en parallèle" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;fillColor=none;strokeColor=#2F5597;" vertex="1" parent="1"><mxGeometry x="160" y="190" width="920" height="120" as="geometry"/></mxCell><mxCell id="cr4" value="&lt;b&gt;Qwen3.8-27B&lt;/b&gt;&lt;br/&gt;raisonnement bas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#DCE6F0;strokeColor=#2F5597;" vertex="1" parent="1"><mxGeometry x="200" y="230" width="240" height="60" as="geometry"/></mxCell><mxCell id="cr5" value="&lt;b&gt;Qwen3.5-397B&lt;/b&gt;&lt;br/&gt;sans raisonnement" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#DCE6F0;strokeColor=#2F5597;" vertex="1" parent="1"><mxGeometry x="500" y="230" width="240" height="60" as="geometry"/></mxCell><mxCell id="cr6" value="&lt;b&gt;GPT-OSS-120B&lt;/b&gt;&lt;br/&gt;raisonnement bas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#DCE6F0;strokeColor=#2F5597;" vertex="1" parent="1"><mxGeometry x="800" y="230" width="240" height="60" as="geometry"/></mxCell><mxCell id="cr7" value="&lt;b&gt;2 · Arbitre&lt;/b&gt; : Qwen3.8-27B (réflexion)&lt;br/&gt;confronte les 3 versions point par point&lt;br/&gt;revient à la transcription en cas de divergence&lt;br/&gt;garde l'&lt;b&gt;union&lt;/b&gt; de ce qui est étayé" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#E2F0D9;strokeColor=#548235;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="400" height="100" as="geometry"/></mxCell><mxCell id="cr8" value="&lt;b&gt;3 · Contrôleur&lt;/b&gt; : Qwen3.5-397B&lt;br/&gt;revérifie chaque élément, cherche les oublis&lt;br/&gt;→ corrections appliquées par le programme" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#E2F0D9;strokeColor=#548235;" vertex="1" parent="1"><mxGeometry x="420" y="510" width="400" height="90" as="geometry"/></mxCell><mxCell id="cr9" value="&lt;b&gt;4 · Contrôle des dates&lt;/b&gt; (programme)&lt;br/&gt;jour de semaine ↔ date · « vendredi » → date réelle&lt;br/&gt;incohérences → « Points à vérifier »" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#BF9000;" vertex="1" parent="1"><mxGeometry x="420" y="650" width="400" height="80" as="geometry"/></mxCell><mxCell id="cr10" value="&lt;b&gt;Temps de parole&lt;/b&gt;&lt;br/&gt;calculé (pas par un LLM)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#BF9000;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="220" height="80" as="geometry"/></mxCell><mxCell id="cr11" value="&lt;b&gt;report.json&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;verticalAlign=middle;fillColor=#FCE4D6;strokeColor=#C55A11;" vertex="1" parent="1"><mxGeometry x="520" y="780"